{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:backend": "tsx watch src/server.ts",
    "prebuild": "node -e \"import fs from 'fs'; if (!process.env.DATABASE_URL && !fs.existsSync('.env')) fs.writeFileSync('.env', 'DATABASE_URL=\\\"file:./dev.db\\\"\\n');\"",
    "build": "prisma generate && tsc",
    "render-build": "node -e \"import fs from 'fs'; if (!process.env.DATABASE_URL && !fs.existsSync('.env')) fs.writeFileSync('.env', 'DATABASE_URL=\\\"file:./dev.db\\\"\\n');\" && prisma db push && npm run seed && npm run build",
    "start": "node dist/server.js",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Credit Analysis & Loan Recommendation Backend",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7"
  }
}
